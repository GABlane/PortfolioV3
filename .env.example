# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and never sent to the browser.

# Google Gemini API key — create one at https://aistudio.google.com/apikey
# Server-only: do NOT prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional: Gemini model for the portfolio chatbot (default: gemini-3.5-flash-lite)
GEMINI_MODEL=

# Optional: chat abuse controls
CHAT_RATE_LIMIT_PER_IP=
CHAT_DAILY_LIMIT=

# Optional: shared store for rate limits + answer cache across serverless instances
# (Upstash Redis via the Vercel Marketplace). Without these, limits are per-instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: production URL for canonical links and the sitemap, e.g. https://your-domain.com
NEXT_PUBLIC_SITE_URL=
